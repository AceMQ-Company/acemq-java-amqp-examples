<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.acemq.examples</groupId>
    <artifactId>acemq-java-amqp-examples</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>02-tls-and-credentials</artifactId>
  <name>basic/02 — TLS and credentials</name>

  <dependencies>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-amqp-core</artifactId>
    </dependency>
    <!-- The security policy types. Compiled against, unlike the transport. -->
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-security-api</artifactId>
      <version>${acemq.version}</version>
    </dependency>
    <dependency>
      <groupId>org.acemq</groupId>
      <artifactId>acemq-transport-rabbitmq</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- ./mvnw -Pgencert     (or: mvn -Pgencert)
         Writes ./certs and the rabbitmq.conf the compose file mounts. A profile
         rather than a bare command line so the arguments live in the repository
         and a reader has one thing to type. -->
    <profile>
      <id>gencert</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.acemq</groupId>
            <artifactId>acemq-security-dev</artifactId>
            <version>${acemq.version}</version>
            <executions>
              <execution>
                <id>certs</id>
                <phase>generate-resources</phase>
                <goals><goal>certs</goal></goals>
              </execution>
            </executions>
            <configuration>
              <out>${project.basedir}/certs</out>
              <broker>localhost</broker>
              <password>acemq-dev</password>
              <days>30</days>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>org.acemq.examples.basic.TlsAndCredentials</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
