<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.acemq.examples</groupId>
  <artifactId>acemq-java-amqp-examples</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>AceMQ for Java — examples</name>
  <description>Runnable examples for AceMQ for Java.</description>

  <!-- Every example is its own module so it can be read, copied and run on its
       own. A reader should be able to open one directory and see the whole
       thing, rather than tracing shared helpers across the repository. -->
  <modules>
    <module>basic/01-publish-and-confirm</module>
    <module>basic/02-tls-and-credentials</module>
    <module>basic/03-retries-and-dead-letters</module>
    <module>basic/04-replay</module>
    <module>basic/05-idempotent-consumer</module>
    <module>basic/06-transactional-outbox</module>
    <module>basic/07-serialization</module>
    <module>basic/08-ordered-per-key</module>
    <module>basic/09-streams</module>
    <module>basic/10-pipelines</module>
    <module>intermediate/01-consumer-groups</module>
    <module>intermediate/02-interceptors</module>
    <module>intermediate/03-telemetry</module>
    <module>intermediate/04-testing-without-a-broker</module>
    <module>intermediate/05-blocked-connections</module>
    <module>intermediate/06-topology-as-data</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>

    <!-- The released version, never a snapshot. These examples are what a
         newcomer runs first, so they resolve exactly what the documentation
         tells them to depend on. -->
    <acemq.version>0.2.3</acemq.version>

    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.11.4</junit.version>
    <assertj.version>3.27.0</assertj.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <h2.version>2.3.232</h2.version>
    <exec.plugin.version>3.5.0</exec.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.5.2</maven.failsafe.plugin.version>
  </properties>

  <repositories>
    <repository>
      <id>acemq</id>
      <name>AceMQ</name>
      <url>https://acemq-company.github.io/maven/</url>
    </repository>
  </repositories>

  <!-- Separate from <repositories>, and easy to miss: that element tells Maven
       where dependencies come from, and plugins are resolved from here instead.
       Without it, acemq-security-dev is looked for in Maven Central alone and
       `mvn -Pgencert` fails on any machine whose local repository does not
       already happen to hold it. -->
  <pluginRepositories>
    <pluginRepository>
      <id>acemq</id>
      <name>AceMQ</name>
      <url>https://acemq-company.github.io/maven/</url>
    </pluginRepository>
  </pluginRepositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.acemq</groupId>
        <artifactId>acemq-amqp-core</artifactId>
        <version>${acemq.version}</version>
      </dependency>
      <dependency>
        <groupId>org.acemq</groupId>
        <artifactId>acemq-transport-rabbitmq</artifactId>
        <version>${acemq.version}</version>
      </dependency>
      <dependency>
        <groupId>org.acemq</groupId>
        <artifactId>acemq-amqp-patterns</artifactId>
        <version>${acemq.version}</version>
      </dependency>
      <dependency>
        <groupId>org.acemq</groupId>
        <artifactId>acemq-amqp-test</artifactId>
        <version>${acemq.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every example logs. Seeing what the library did is half the point. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Every example is verified by running it against a real broker, so these
           integration tests are the point of this repository rather than an extra.
           Failsafe runs them on `mvn verify`; without it they are named like tests,
           collected by nobody, and quietly never run — which is exactly how an
           examples repository rots without anyone noticing. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.failsafe.plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
